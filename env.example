# WeChat Download API 配置文件
# 复制为 .env 后使用: cp env.example .env
#
# 数据源是微信读书 —— 不需要微信公众号，也没有公众号后台的任何配置项。
# 登录方式：管理页 /login.html 扫码登录微信读书（凭证存在 data/ 目录，重启不丢）。

# ===== 微信读书 =====
# 一般不用填 —— 扫码登录即可。这里填了会优先于扫码结果（适合用配置管理部署的场景）。
# 手动取法：浏览器登录 https://weread.qq.com → F12 → Network → 任意请求
#   → Request Headers 复制完整 Cookie（需含 wr_skey / wr_vid / wr_rt）
WEREAD_COOKIE=

# wr_skey 是短效令牌，过期接口返回 -2012；wr_rt 是长期令牌。
# 开启后遇到 -2012 自动用 wr_rt 换新的 wr_skey 并重试，不用重新扫码。
WEREAD_AUTO_RENEW=true

# 登录态守护：后台定期探活，发现失效就主动续期，不用等采集撞上 -2012。
# 续不回来（wr_rt 也过期了）会发 webhook 报警，管理页也会挂红条提示重新扫码。
WEREAD_KEEPALIVE=true
# 检查间隔（秒），默认 6 小时；低于 300 会被抬到 300
WEREAD_KEEPALIVE_INTERVAL=21600

# 微信读书 App 域（i.weread.qq.com）。比网页域多一个「搜全网公众号」的能力。
# 它只认 App UA + 已续期的 wr_skey；不通会自动退回网页域（10 分钟冷却）。
# 关掉也不影响采集，只是搜号时只能在自己书架里匹配。
WEREAD_APP_API=true

# 微信读书只对「书架上」的公众号返回文章，默认采集前自动加入书架
# （相当于在微信读书里关注）。不想改动书架就设 false，然后手动在 App 里关注。
WEREAD_AUTO_ADD_SHELF=true

# 请求间隔（秒），防限流。正文接口限得比列表严，别调太小。
WEREAD_CONTENT_INTERVAL=2
WEREAD_PAGE_INTERVAL=1
# 单次列表采集最多翻几页（每页约 50 条）。想挖更深的历史文章就调大。
WEREAD_MAX_PAGES=5

# ===== RSS 轮询 =====
# 轮询间隔（秒），默认 3600（1 小时）。订阅时会立即抓一次，不用等这个间隔。
RSS_POLL_INTERVAL=3600
# 每次轮询每个公众号拉取的文章数
ARTICLES_PER_POLL=10
# 轮询时是否一并抓正文（true/false）
RSS_FETCH_FULL_CONTENT=true

# ===== 限频 =====
RATE_LIMIT_GLOBAL=10
RATE_LIMIT_PER_IP=5
RATE_LIMIT_ARTICLE_INTERVAL=3

# ===== Webhook 通知（留空禁用，支持企业微信群机器人）=====
WEBHOOK_URL=
WEBHOOK_NOTIFICATION_INTERVAL=300

# ===== 服务 =====
# 网站访问地址，RSS 图片代理靠它拼绝对地址，必须配成实际地址
# 例如: http://你的IP:5000 或 https://你的域名.com
SITE_URL=http://localhost:5000
PORT=5000
HOST=0.0.0.0
DEBUG=false

# 数据库路径（默认 ./data/rss.db，Docker 环境一般无需修改）
# RSS_DB_PATH=/app/data/rss.db

# ===== MCP（AI 客户端接入，可选）=====
# 开启后 Claude/Codex/Cline 等 AI 客户端可直接搜索/订阅/读你的公众号文章。
# ENABLE_MCP=1 且设置 MCP_TOKEN 才启用；客户端需配 Authorization: Bearer <MCP_TOKEN>。
ENABLE_MCP=0
MCP_TOKEN=
# MCP 资源 URL（部署域名，用于 DNS-rebinding 白名单；默认 localhost）
# MCP_RESOURCE_URL=https://你的域名/mcp
