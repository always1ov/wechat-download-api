# WeChat Download API 配置文件
# 复制为 .env 后使用: cp env.example .env

# 认证信息 (登录后自动填充，无需手动配置)
WECHAT_TOKEN=
WECHAT_COOKIE=
WECHAT_FAKEID=
WECHAT_NICKNAME=
WECHAT_EXPIRE_TIME=

# 限频配置 (单位: 次/分钟 或 秒)
RATE_LIMIT_GLOBAL=10
RATE_LIMIT_PER_IP=5
RATE_LIMIT_ARTICLE_INTERVAL=3

# Webhook 通知 (留空则禁用，支持企业微信群机器人)
WEBHOOK_URL=
# 同一事件通知最小间隔（秒），防止重复轰炸
WEBHOOK_NOTIFICATION_INTERVAL=300

# RSS 订阅配置
# 轮询间隔（秒），默认 3600（1 小时）
RSS_POLL_INTERVAL=3600
# 每次轮询拉取的文章批次数，默认 10（高频更新的公众号可适当增大）
ARTICLES_PER_POLL=10
# RSS 轮询时是否获取完整文章内容（true/false），默认 true
# ⚠️ 启用时强烈建议配置下方的 PROXY_URLS，避免账号被微信风控
RSS_FETCH_FULL_CONTENT=true

# ===== 微信读书备用通道（强烈建议配置）=====
# 解决什么问题：公众号后台凭证约 4 天过期、appmsgpublish 有频率风控、
# 正文直抓会触发验证码 —— 任一发生，轮询和文章接口就静默失联。
# 配好之后，后台不可用时文章列表与正文自动改走 weread.qq.com，采集不中断。
#
# 最省事的配置方式：管理页 /admin.html 点「扫码登录微信读书」，微信扫一下即可。
# 想手动配也行 —— 浏览器登录 https://weread.qq.com → F12 → Network → 点开任意请求
#   → Request Headers 里复制完整 Cookie（需含 wr_skey / wr_vid / wr_rt）
# 注意：本变量优先级高于管理页保存值，设了就以它为准。
WEREAD_COOKIE=

# wr_skey 是短效令牌，过期接口会返回 -2012；wr_rt 是长期令牌。
# 开启后遇到 -2012 会自动用 wr_rt 换新的 wr_skey 并重试，不用重新扫码。
WEREAD_AUTO_RENEW=true

# 微信读书 App 域（i.weread.qq.com）。比网页域多一个能力：能搜公众号，
# 让搜索也不必依赖公众号后台。它只认 App UA + 已续期的 wr_skey，
# 不通会自动退回网页域（10 分钟冷却），设 false 可彻底关掉。
WEREAD_APP_API=true

# 取数策略：auto=后台优先、失败回退微信读书（默认）；mp=只用后台；weread=只用微信读书
ARTICLE_SOURCE=auto

# 强制开关微信读书通道。留空=配了 WEREAD_COOKIE 就启用
# WEREAD_ENABLED=1

# 微信读书只对「书架上」的公众号返回文章，默认采集前自动加入书架（相当于在微信读书里关注）
# 不想改动书架就设为 false，然后手动在微信读书里关注这些公众号
WEREAD_AUTO_ADD_SHELF=true

# 请求间隔（秒），防微信读书限流。正文接口限得比列表严，别调太小
WEREAD_CONTENT_INTERVAL=2
WEREAD_PAGE_INTERVAL=1
# 单次列表采集最多翻几页（每页约 50 条）
WEREAD_MAX_PAGES=5

# SOCKS5 代理池（⚠️ 启用RSS完整内容时强烈建议配置，避免账号风控）
# 用途：分散请求 IP，配合 Chrome TLS 指纹模拟，有效规避微信封控
# 不配置代理直连微信可能导致：频繁验证、账号限制、IP 封禁
# 支持 SOCKS5 代理，多个用逗号分隔，建议 2-3 个即可
# 示例: socks5://ip1:1080,socks5://ip2:1080,socks5://user:pass@ip3:1080
# 留空则直连（仅适用于少量订阅或禁用 RSS_FETCH_FULL_CONTENT 的情况）
PROXY_URLS=

# 服务配置
# 网站URL(用于RSS图片代理,必须配置为实际访问地址)
# 例如: http://你的IP:5000 或 https://你的域名.com
SITE_URL=http://localhost:5000
PORT=5000
HOST=0.0.0.0
DEBUG=false

# 数据库路径（默认 ./data/rss.db，Docker 环境一般无需修改）
# RSS_DB_PATH=/app/data/rss.db

# ===== MCP（AI 客户端接入，可选）=====
# 开启后 Claude/Codex/Cline 等 AI 客户端可直接搜索/订阅/读你的公众号文章。
# ENABLE_MCP=1 且设置 MCP_TOKEN 才启用；客户端需配 Authorization: Bearer <MCP_TOKEN>。
ENABLE_MCP=0
MCP_TOKEN=
# MCP 资源 URL（部署域名，用于 DNS-rebinding 白名单；默认 localhost）
# MCP_RESOURCE_URL=https://你的域名/mcp
